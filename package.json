{
  "name": "opentake-standard",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-concurrency=4 server/*.test.ts && npm run test:desktop && npm run test:openscreen",
    "build": "npm run build:openscreen && vite build",
    "dev": "vite",
    "build:app": "npm run build && node desktop/build-app.mjs",
    "test:desktop": "node --test desktop/*.test.cjs",
    "build:openscreen": "npm --prefix vendor/openscreen run build:linkreader",
    "test:openscreen": "npm --prefix vendor/openscreen run test:standard",
    "doctor": "node scripts/doctor.cjs",
    "build:live": "npm run build:openscreen && vite build --emptyOutDir false"
  },
  "dependencies": {
    "@hyperframes/core": "0.8.198",
    "@hyperframes/engine": "0.8.198",
    "@hyperframes/lint": "0.8.198",
    "@hyperframes/parsers": "0.8.198",
    "@hyperframes/producer": "0.8.198",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "clsx": "2.1.1",
    "linkedom": "0.18.14",
    "lucide-react": "0.562.0",
    "playwright-core": "1.63.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "7.18.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "zod": "4.6.7",
    "three": "0.180.0",
    "d3-color": "3.1.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-interpolate": "3.0.1",
    "d3-array": "3.2.4",
    "d3-ease": "3.0.1",
    "d3-format": "3.1.0",
    "d3-path": "3.1.0",
    "d3-time": "3.1.0",
    "d3-time-format": "4.1.0",
    "d3-timer": "3.0.1",
    "internmap": "2.0.3",
    "vite": "7.3.0",
    "@vitejs/plugin-react": "5.1.2",
    "esbuild": "0.27.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "3.4.19",
    "autoprefixer": "10.4.23",
    "postcss": "8.5.31",
    "tailwindcss-animate": "1.0.7",
    "jsdom": "30.0.1",
    "electron": "41.10.7",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.cjs",
  "description": "OpenTake Standard desktop creative workspace"
}
