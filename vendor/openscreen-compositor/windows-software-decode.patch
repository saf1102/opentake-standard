+    #[test]
+    fn h264_device_init_failure_falls_back_to_software_and_keeps_seek_clock() {
+        let gpu = Gpu::create(false).expect("hardware device for injected failure test");
+        let path = encode_color(&["-c:v", "libopenh264", "-b:v", "200k"], "software-fallback.mp4");
+        {
+            let _fault = install_simple_decode_frame_fault(DecodeFrameTestFault::HardwareDeviceInit);
+            let mut decoder = unsafe { Decoder::open(path.to_str().unwrap(), &gpu) }
+                .expect("device initialization failure must fall back");
+            assert!(decoder.cpu.is_some());
+            assert!(decoder.hwdev.is_null(), "failed hardware context must be released");
+            let frame = unsafe { first_decoded_frame(&mut decoder) };
+            assert_eq!(unsafe { (*frame).width }, 64);
+            assert_eq!(unsafe { (*frame).height }, 64);
+            let frame = unsafe { decoder.seek_to(0.2) }.expect("software seek");
+            assert!(!frame.is_null());
+            assert!(unsafe { (*frame).best_effort_timestamp } as f64 * unsafe { decoder.tb_sec() } >= 0.2);
+        }
+        let decoder = unsafe { Decoder::open(path.to_str().unwrap(), &gpu) }
+            .expect("ordinary hardware decoder");
+        assert!(decoder.cpu.is_none(), "healthy hardware remains the default");
+        println!("CORE_ASSERTIONS_COMPLETED:h264_device_init_failure_falls_back_to_software_and_keeps_seek_clock");
+    }
