+//! CFR timing at the first mux write, shared by the Windows and Mac pipelines.
+use crate::ffi::*;
+use anyhow::{bail, Result};
+use std::ptr;
+
+pub(super) unsafe fn packet_duration(packet: *mut AVPacket, encoder: *mut AVCodecContext) -> Result<()> {
+    // Some encoders, including h264_mf, omit duration even on the flush packet.
+    // MOV infers earlier durations from DTS but cannot infer the final sample.
+    // Fill in the encoder clock BEFORE rescale; preserve valid durations/PTS/DTS.
+    if (*packet).duration <= 0 {
+        let rate = (*encoder).framerate;
+        if rate.num <= 0 || rate.den <= 0 {
+            bail!("missing encoder frame rate for CFR packet duration");
+        }
+        (*packet).duration = av_rescale_q(
+            1, AVRational { num: rate.den, den: rate.num }, (*encoder).time_base,
+        );
+        if (*packet).duration <= 0 {
+            bail!("encoder time base cannot represent one CFR frame");
+        }
+    }
+    Ok(())
+}
+
+pub(super) unsafe fn write_header(output: *mut AVFormatContext, rate: AVRational) -> Result<()> {
+    // MOV's default 1000-Hz movie clock rounds elst to milliseconds. Even with
+    // correct stts/mdhd this can clip the demuxed stream by several video ticks.
+    // Choose an exact frame-compatible movie clock at header creation; no duration
+    // overrides or post-export changes. Precision is at least the previous 1 ms.
+    if rate.num <= 0 || rate.den <= 0 { bail!("invalid CFR frame rate"); }
+    let scale = rate.num.checked_mul(1000).ok_or_else(|| anyhow::anyhow!("CFR movie clock overflow"))?;
+    let mut options = ptr::null_mut();
+    averr(av_dict_set_int(&mut options, b"movie_timescale\0".as_ptr().cast(), scale as i64, 0), "movie timescale")?;
+    let result = avformat_write_header(output, &mut options);
+    av_dict_free(&mut options);
+    averr(result, "write_header")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn missing_duration_is_in_encoder_ticks_and_existing_duration_is_preserved() {
+        unsafe {
+            let mut enc = avcodec_alloc_context3(ptr::null());
+            let mut packet = av_packet_alloc();
+            assert!(!enc.is_null() && !packet.is_null());
+            (*enc).framerate = AVRational { num: 24, den: 1 };
+            (*enc).time_base = AVRational { num: 1, den: 48 };
+            (*packet).pts = 6;
+            (*packet).dts = 2;
+            packet_duration(packet, enc).unwrap();
+            assert_eq!((*packet).duration, 2);
+            (*packet).duration = 4;
+            packet_duration(packet, enc).unwrap();
+            assert_eq!((*packet).duration, 4);
+            assert_eq!(((*packet).pts, (*packet).dts), (6, 2));
+            av_packet_free(&mut packet);
+            avcodec_free_context(&mut enc);
+        }
+    }
+}
