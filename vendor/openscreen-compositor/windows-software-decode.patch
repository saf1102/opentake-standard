+//! Container regression shared by the Windows and Mac production drain paths.
+//! No remux, metadata override, browser, GPU or installed application is involved.
+use super::drain_encoder;
+use crate::ffi::*;
+use std::{ffi::CString, path::Path, ptr};
+
+pub(super) unsafe fn assert_container(path: &Path, frames: i64, fps: i32) {
+    let name = CString::new(path.to_string_lossy().as_bytes()).unwrap();
+    let mut input = ptr::null_mut();
+    averr(avformat_open_input(&mut input, name.as_ptr(), ptr::null_mut(), ptr::null_mut()), "read exported MP4").unwrap();
+    averr(avformat_find_stream_info(input, ptr::null_mut()), "read streams").unwrap();
+    let index = av_find_best_stream(input, AVMediaType::AVMEDIA_TYPE_VIDEO, -1, -1, ptr::null_mut(), 0);
+    assert!(index >= 0);
+    let stream = sn_fmt_stream(input, index);
+    let tb = (*stream).time_base;
+    let rate = (*stream).avg_frame_rate;
+    let duration = (*stream).duration;
+    let count = (*stream).nb_frames;
+    avformat_close_input(&mut input);
+    assert_eq!(count, frames, "all encoded frames must be muxed");
+    assert!(rate.num > 0 && rate.den > 0, "average frame rate must be present");
+    assert_eq!(rate.num as i64, fps as i64 * rate.den as i64, "average rate must equal requested CFR");
+    let expected = av_rescale_q(frames, AVRational { num: 1, den: fps }, tb);
+    assert!((duration - expected).abs() <= 1, "last frame duration lost: {duration}, expected {expected}, fps={fps}");
+    eprintln!("CONTAINER_DURATION_OK fps={fps} frames={count} duration={duration} time_base={}/{} avg={}/{} path={}", tb.num, tb.den, rate.num, rate.den, path.display());
+}
+
+unsafe fn encode_and_check(name: &str, format: AVPixelFormat::Type, fps: i32, frames: i64) {
+    let dir = std::env::var_os("OPENSCREEN_DURATION_TEST_OUTPUT").map(std::path::PathBuf::from)
+        .unwrap_or_else(|| std::env::temp_dir().join(format!("openscreen-duration-{}", std::process::id())));
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join(format!("{name}-{fps}-{frames}.mp4"));
+    let cname = CString::new(name).unwrap();
+    let codec = avcodec_find_encoder_by_name(cname.as_ptr());
+    assert!(!codec.is_null(), "required software encoder {name} missing; do not skip");
+    let mut enc = avcodec_alloc_context3(codec);
+    (*enc).width = 64;
+    (*enc).height = 64;
+    (*enc).pix_fmt = format;
+    (*enc).time_base = AVRational { num: 1, den: fps };
+    (*enc).framerate = AVRational { num: fps, den: 1 };
+    (*enc).bit_rate = 200_000;
+    (*enc).flags |= AV_CODEC_FLAG_GLOBAL_HEADER as i32;
+    averr(avcodec_open2(enc, codec, ptr::null_mut()), "open software encoder").unwrap();
+    let file = CString::new(path.to_string_lossy().as_bytes()).unwrap();
+    let mut output = ptr::null_mut();
+    averr(avformat_alloc_output_context2(&mut output, ptr::null(), ptr::null(), file.as_ptr()), "create MP4").unwrap();
+    let stream = avformat_new_stream(output, ptr::null());
+    assert!(!stream.is_null());
+    averr(avcodec_parameters_from_context((*stream).codecpar, enc), "codec parameters").unwrap();
+    (*stream).time_base = (*enc).time_base;
+    let mut pb = ptr::null_mut();
+    averr(avio_open(&mut pb, file.as_ptr(), AVIO_FLAG_WRITE as i32), "open MP4").unwrap();
+    sn_fmt_set_pb(output, pb);
+    super::video_mux_timing::write_header(output, (*enc).framerate).unwrap();
+    let mut frame = av_frame_alloc();
+    (*frame).format = format;
+    (*frame).width = 64;
+    (*frame).height = 64;
+    averr(av_frame_get_buffer(frame, 0), "frame buffer").unwrap();
+    let mut packet = av_packet_alloc();
+    for pts in 0..frames {
+        averr(av_frame_make_writable(frame), "writable frame").unwrap();
+        for plane in 0..if format == AVPixelFormat::AV_PIX_FMT_NV12 { 2 } else { 3 } {
+            let rows = if plane == 0 { 64 } else { 32 };
+            ptr::write_bytes((*frame).data[plane], if plane == 0 { 64 + (pts % 64) as u8 } else { 128 }, (*frame).linesize[plane] as usize * rows);
+        }
+        (*frame).pts = pts;
+        // The production compositor provides PTS, but no input duration. Exercise
+        // the real encoder's missing-duration packets, including delayed flush.
+        (*frame).duration = 0;
+        averr(avcodec_send_frame(enc, frame), "send frame").unwrap();
+        drain_encoder(enc, output, stream, packet).unwrap();
+    }
+    averr(avcodec_send_frame(enc, ptr::null()), "flush encoder").unwrap();
+    drain_encoder(enc, output, stream, packet).unwrap();
+    averr(av_write_trailer(output), "trailer").unwrap();
+    avio_closep(&mut pb);
+    avformat_free_context(output);
+    av_packet_free(&mut packet);
+    av_frame_free(&mut frame);
+    avcodec_free_context(&mut enc);
+    assert_container(&path, frames, fps);
+    if std::env::var_os("OPENSCREEN_DURATION_TEST_OUTPUT").is_none() { std::fs::remove_file(path).unwrap(); }
+}
+
+#[test]
+fn software_export_duration_includes_last_frame_24_30_60() {
+    #[cfg(windows)]
+    let candidates = [("h264_mf", AVPixelFormat::AV_PIX_FMT_NV12), ("libopenh264", AVPixelFormat::AV_PIX_FMT_YUV420P)];
+    // Homebrew's local Mac SDK does not ship libopenh264. libx264 is only a test
+    // fixture; this does not add a GPL encoder to the product's candidate list.
+    #[cfg(target_os = "macos")]
+    let candidates = [("libx264", AVPixelFormat::AV_PIX_FMT_YUV420P)];
+    for (name, format) in candidates {
+        for fps in [24, 30, 60] {
+            for frames in [1, 7, 200] {
+                unsafe { encode_and_check(name, format, fps, frames); }
+            }
+        }
+    }
+}
